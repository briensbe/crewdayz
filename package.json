{
  "name": "crewdayz",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:github": "ng build --base-href \"/crewdayz/\" --configuration production",
    "deploy:github": "angular-cli-ghpages --dir=dist/crewdayz/browser",
    "deploy": "pnpm run build:github && pnpm run deploy:github",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "dependencies": {
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@supabase/supabase-js": "^2.108.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "lucide-angular": "^1.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.29",
    "@angular/cli": "^21.2.29",
    "@angular/compiler-cli": "^21.2.25",
    "@types/node": "^26.0.0",
    "angular-cli-ghpages": "^3.1.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.22.4",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  },
  "pnpm": {
    "overrides": {
      "uuid": "^11.1.1",
      "fast-uri": "^3.1.9"
    }
  }
}
